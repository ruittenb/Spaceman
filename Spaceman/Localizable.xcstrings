    "If the display order seems erratic, please pay close attention to the horizontal alignment in System Settings → Displays → Arrange." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Bildschirmreihenfolge nicht stimmt, achten Sie bitte auf die horizontale Ausrichtung in Systemeinstellungen → Displays → Anordnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el orden de las pantallas parece incorrecto, presta atención a la alineación horizontal en Ajustes del Sistema → Pantallas → Organizar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el orden de las pantallas parece incorrecto, presta atención a la alineación horizontal en Configuración del Sistema → Pantallas → Organizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’ordre des écrans ne semble pas correct, vérifiez l’alignement horizontal dans Réglages système → Écrans → Disposition."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de beeldschermvolgorde niet correct is, let dan goed op de horizontale rangschikking in Systeeminstellingen → Beeldschermen → Ordenen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если порядок дисплеев кажется неправильным, проверьте выравнивание по горизонтали в разделе Системные настройки → Дисплеи → Расстановка."
          }
        }
      }
    },
