    "Spaceman reads the Mission Control keyboard shortcuts directly from your system settings. To change them, use this button." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaceman liest die Mission Control-Kurzbefehle direkt aus Ihren Systemeinstellungen. Verwenden Sie diese Taste, um sie zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaceman lee los atajos de teclado de Mission Control directamente de los ajustes del sistema. Para cambiarlos, usa este botón."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaceman lee los atajos de teclado de Mission Control directamente de la configuración del sistema. Para cambiarlos, usa este botón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaceman lit les raccourcis clavier de Mission Control directement depuis vos réglages système. Pour les modifier, utilisez ce bouton."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaceman leest de Mission Control-sneltoetsen rechtstreeks uit uw systeeminstellingen. Gebruik deze knop om ze te wijzigen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaceman считывает сочетания клавиш Mission Control прямо из системных настроек. Чтобы изменить их, нажмите эту кнопку."
          }
        }
      }
    },
    "Spaceman will attempt to unshrink the menu bar icon when you switch spaces, or trigger a manual refresh." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaceman versucht, das Menüleistensymbol wieder zu vergrößern, wenn Sie zwischen Spaces wechseln oder eine manuelle Aktualisierung auslösen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaceman intentará restaurar el tamaño del icono de la barra de menús al cambiar de escritorio o activar una actualización manual."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
